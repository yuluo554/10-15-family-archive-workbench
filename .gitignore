# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.spec
# 例外：famarchive.spec 是 exe 可复现打包的唯一来源（DEC3=A），随仓入库
!famarchive.spec
.venv/
venv/

# 环境
.env
*.env

# 隐私与本地数据（不入库）
_private/
data/raw/*
# M1 例外：DCMI 公开参考快照（官方 RDF/HTML，无隐私内容），按台账入库
!data/raw/dcmi/
!data/raw/dcmi/**

# IDE / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 日志与临时
*.log
tmp/
*.tmp

# 发布产物本地副本（exe zip 不入 git，走 GitHub Release 附产物）
dist-release/
